sequenceDiagram
    autonumber
    actor Admin as Адміністратор
    participant API as InventoryController
    participant Game as GameService
    participant Char as CharacterRepository
    participant Inv as InventoryRepository

    Note over Admin: Передумова: користувач - адміністратор гри,<br/>інвентар персонажа відкрито

    Admin->>API: updatePositionQuantity(gameId, characterId, itemId, quantity)
    activate API

    API->>Game: ensureAdmin(gameId, adminId)
    activate Game
    Game-->>API: true
    deactivate Game

    API->>Char: existsCharacterInGame(gameId, characterId)
    activate Char
    Char-->>API: true
    deactivate Char

    API->>Inv: findPosition(characterId, itemId)
    activate Inv
    Inv-->>API: position

    alt position is null
        API-->>Admin: 404 positionNotFound
    else quantity < 1
        API-->>Admin: 400 quantity should be >= 1
    else
        API->>Inv: updateQuantity(characterId, itemId, quantity)
        Inv-->>API: positionSaved
        API-->>Admin: 200 positionUpdated
    end

    deactivate Inv
    deactivate API
