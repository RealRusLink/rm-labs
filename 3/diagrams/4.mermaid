sequenceDiagram
    autonumber
    actor Admin as Адміністратор
    participant API as InventoryController
    participant Game as GameService
    participant Char as CharacterRepository
    participant Inv as InventoryRepository

    Note over Admin: Передумова: користувач - адміністратор гри,<br/>предмет є в інвентарі персонажа

    Admin->>API: removeInventoryItem(gameId, characterId, itemId)
    activate API

    API->>Game: ensureAdmin(gameId, adminId)
    activate Game
    Game-->>API: true
    deactivate Game

    API->>Char: existsCharacterInGame(gameId, characterId)
    activate Char
    Char-->>API: true
    deactivate Char

    API->>Inv: deletePosition(characterId, itemId)
    activate Inv

    alt position is deleted
        Inv-->>API: 1
        API-->>Admin: 204 positionDeleted
    else position not found
        Inv-->>API: 0
        API-->>Admin: 404 positionNotFound
    end

    deactivate Inv
    deactivate API
